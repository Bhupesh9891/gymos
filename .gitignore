```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
*.js
*.ts
*.tsx
*.css

# Environment variables
.env
.env.local
*.env.*

# IDE files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# Logs
*.log

# Coverage
coverage/
htmlcov/
.coverage

# Python specific
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.tox/

# Node.js specific
npm-debug.log*
yarn-debug.log*
yarn-error.log*
node_modules/
.cache/
.nyc_output/
coverage/
build/
dist/
*.min.js
*.min.css

# Compiled and binary files
*.o
*.obj
*.exe
*.dll
*.so
*.a
*.out

# OS generated files
.DS_Store
Thumbs.db
ehthumbs.db
Icon?
.directory
.hgcheckout
```